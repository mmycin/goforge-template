APP_NAME=goforge
APP_VERSION=1.0.0
APP_MODULE=github.com/mmycin/goforge
APP_DEBUG=true
APP_KEY= # Generate via `goforge app gen:key`
APP_HOST=127.0.0.1
APP_PORT=3000

GRPC_ENABLE=true
GRPC_REFLECTION=true
GRPC_HOST=127.0.0.1
GRPC_PORT=50051

RATE_LIMIT_PER_MINUTE=10

# TLS/HTTPS configuration
# Set TLS_ENABLED=true to serve over HTTPS instead of HTTP.
# For local development, generate a self-signed cert:
#   openssl req -x509 -newkey rsa:4096 -keyout key.pem -out cert.pem -days 365 -nodes
# For production, point to certificates issued by your CA or managed by Let's Encrypt.
TLS_ENABLED=false
TLS_CERT_FILE=cert.pem
TLS_KEY_FILE=key.pem

ENCRYPTION_KEY= 
ENCRYPTION_ROUNDS=12
ENCRYPTION_SALT=

# Options: sqlite, mysql, postgres, sqlserver
DB_CONNECTION=sqlite
DB_NAME=forge.db
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=root
# DB_DEV_NAME=forge_dev
DB_MIGRATOR=atlas # atlas | gorm


LOG_TYPE=terminal # terminal | file | both
LOG_LEVEL=info
LOG_PATH=storage/logs/app.log
LOG_FORMAT=log # json | yaml | log
